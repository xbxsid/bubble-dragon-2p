<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A0A2E">

    <!-- High-score label at top -->
    <TextView
        android:id="@+id/tvHighScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏆 Best: 0"
        android:textColor="#FFD700"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Game Canvas -->
    <com.blockpuzzle.dragon.GameView
        android:id="@+id/gameView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvHighScore"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Control Panel -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#2D1B4E"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Row 1: movement -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btnLeft"
                style="@style/ControlButton"
                android:text="◀"/>

            <Button
                android:id="@+id/btnRotate"
                style="@style/ControlButton"
                android:layout_marginHorizontal="8dp"
                android:text="🔄 Rotate"/>

            <Button
                android:id="@+id/btnRight"
                style="@style/ControlButton"
                android:text="▶"/>
        </LinearLayout>

        <!-- Row 2: drop + system -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnDown"
                style="@style/ControlButton"
                android:text="▼ Soft"/>

            <Button
                android:id="@+id/btnDrop"
                style="@style/ControlButton"
                android:layout_marginHorizontal="6dp"
                android:backgroundTint="#FF6B35"
                android:text="⬇ Drop"/>

            <Button
                android:id="@+id/btnPause"
                style="@style/ControlButton"
                android:layout_marginHorizontal="6dp"
                android:backgroundTint="#9B59B6"
                android:text="⏸ Pause"/>

            <Button
                android:id="@+id/btnRestart"
                style="@style/ControlButton"
                android:backgroundTint="#E74C3C"
                android:text="↺ Restart"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
