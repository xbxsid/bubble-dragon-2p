<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BlockPuzzleDragon" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/dragon_purple</item>
        <item name="colorPrimaryDark">@color/dragon_bg</item>
        <item name="colorAccent">@color/dragon_gold</item>
        <item name="android:windowBackground">@color/dragon_bg</item>
        <item name="android:statusBarColor">@color/dragon_bg</item>
        <item name="android:navigationBarColor">@color/dragon_sidebar</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <style name="ControlButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:backgroundTint">@color/dragon_purple</item>
    </style>
</resources>
